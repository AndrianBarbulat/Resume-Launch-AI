rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── User profiles ──
    match /users/{uid} {
      // Authenticated users can read their own profile
      allow read: if request.auth != null && request.auth.uid == uid;

      // Authenticated users can create only their own profile
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;

      // Authenticated users can update their own profile;
      // they cannot change their uid.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;

      // Authenticated users can delete their own profile
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Resumes ──
    match /resumes/{resumeId} {
      // Anyone can read a resume that has been explicitly made public
      allow read: if resource.data.isPublic == true;

      // Authenticated users can read and delete their own resumes
      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Authenticated users can create resumes only for themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // Authenticated users can update their own resumes;
      // they cannot transfer ownership (userId must remain unchanged)
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }
  }
}