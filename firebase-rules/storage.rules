rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{userId}/{allPaths=**} {
      // Only the owner can upload or overwrite their PDF files
      allow write: if request.auth != null && request.auth.uid == userId;

      // PDFs are publicly readable so share links work without authentication
      allow read: if true;
    }
  }
}
